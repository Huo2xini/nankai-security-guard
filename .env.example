# 数据库模式：json 或 mysql
DB_MODE=mysql

# MySQL 连接信息
MYSQL_CLI=D:\mysql-8.0.31-winx64\bin\mysql.exe
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=nankai_security_guard

# 本地服务端口
PORT=8021

FEISHU_AUTH_REQUIRED=true
FEISHU_APP_ID=
FEISHU_APP_SECRET=
PUBLIC_BASE_URL=http://localhost:8021
FEISHU_REDIRECT_URI=http://localhost:8021/api/auth/callback
FEISHU_SCOPE=
SESSION_SECRET=change-this-random-session-secret

# Optional: Feishu bot webhooks for workflow notifications
FEISHU_EDITOR_WEBHOOK_URL=
FEISHU_REVIEWER_WEBHOOK_URL=

# Optional: Feishu custom bot signature secret. Use this when bot security enables signature verification.
FEISHU_WEBHOOK_SECRET=
FEISHU_EDITOR_WEBHOOK_SECRET=
FEISHU_REVIEWER_WEBHOOK_SECRET=
